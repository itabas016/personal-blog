{
  "name": "itabas-personal-blog",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "ITABAS — personal blog, rebuilt for the AI era. Astro 5 + Tailwind CSS 4.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "new-post": "node scripts/new-post.mjs",
    "migrate": "node scripts/migrate-hexo.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.4.1",
    "astro": "^5.12.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.16.0",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.3.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "sharp@0.34.5": true
  }
}
