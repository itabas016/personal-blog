---
import { APP_GRADIENTS, type App } from "../data/apps";

interface Props {
  app: App;
  class?: string;
}

const { app, class: className = "" } = Astro.props;

const gradient = APP_GRADIENTS[app.gradient] ?? APP_GRADIENTS.violet;

const STATUS: Record<App["status"], { label: string; dot: string }> = {
  live: { label: "Live", dot: "bg-emerald-400" },
  wip: { label: "WIP", dot: "bg-amber-400" },
  archived: { label: "Archived", dot: "bg-zinc-400" },
};
const status = STATUS[app.status];
---

<article class:list={["flex flex-col rounded-2xl border border-line bg-surface p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-[0_8px_30px_-12px] hover:shadow-accent/25", className]}>
  <div class="flex items-start justify-between gap-3">
    <div class={`flex size-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br ${gradient} text-2xl shadow-inner`} aria-hidden="true">
      {app.emoji}
    </div>
    <span class="inline-flex items-center gap-1.5 rounded-full border border-line px-2.5 py-1 text-[11px] font-medium text-muted">
      <span class={`size-1.5 rounded-full ${status.dot}`}></span>{status.label}
    </span>
  </div>

  <h3 class="mt-4 text-lg font-semibold tracking-tight">{app.name}</h3>
  <p class="mt-1.5 flex-1 text-sm leading-relaxed text-muted">{app.tagline}</p>

  <div class="mt-3 flex flex-wrap gap-1.5">
    {app.stack.map((s) => <span class="rounded-md bg-elevated px-2 py-0.5 font-mono text-[11px] text-muted">{s}</span>)}
  </div>

  <div class="mt-4 flex items-center justify-between border-t border-line/60 pt-3 text-xs">
    <span class="text-faint">
      {app.addedAt}
      {
        app.vibeCoded && (
          <span class="ml-2 cursor-help text-accent" title={`AI 协作开发${app.model ? ` · ${app.model}` : ""}`}>
            ✦ vibe-coded
          </span>
        )
      }
    </span>
    <span class="flex items-center gap-3">
      {app.links?.repo && <a class="font-medium text-muted transition-colors hover:text-default" href={app.links.repo} target="_blank" rel="noopener">Repo ↗</a>}
      {app.links?.live && <a class="font-medium text-accent transition-colors hover:text-accent-2" href={app.links.live} target="_blank" rel="noopener">Live ↗</a>}
    </span>
  </div>
</article>
