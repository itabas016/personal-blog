---
interface Props {
  date: Date;
  class?: string;
}

const { date, class: className = "" } = Astro.props;

const formatted = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<time class:list={["text-faint", className]} datetime={date.toISOString()}>
  {formatted}
</time>
