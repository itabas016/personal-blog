---
import BaseLayout from "../layouts/BaseLayout.astro";
import AppCard from "../components/AppCard.astro";
import { apps, CATEGORIES, APP_GRADIENTS, type App } from "../data/apps";

const STATUS: Record<App["status"], { label: string; dot: string }> = {
  live: { label: "Live", dot: "bg-emerald-400" },
  wip: { label: "WIP", dot: "bg-amber-400" },
  archived: { label: "Archived", dot: "bg-zinc-400" },
};
const STATUS_ORDER = { live: 0, wip: 1, archived: 2 } as const;
const byStatus = (a: App, b: App) =>
  STATUS_ORDER[a.status] - STATUS_ORDER[b.status] || b.addedAt.localeCompare(a.addedAt);

// 轮播：全部应用；网格：在营应用（live + wip）；时间线：archived
const ordered = [...apps].sort(byStatus);
const active = ordered.filter((a) => a.status !== "archived");
const archived = apps
  .filter((a) => a.status === "archived")
  .sort((a, b) => b.addedAt.localeCompare(a.addedAt));

const countOf = (id: string) => active.filter((a) => a.category === id).length;
const uncategorized = active.filter((a) => !a.category).length;
const categoryLabel = (app: App) => CATEGORIES.find((c) => c.id === app.category);
---

<BaseLayout
  title="Apps"
  description="Vibe coding 应用展示墙 —— 用 AI Agent 快速构建的小工具与产品，多数托管在 Cloudflare 上。"
>
  <div class="py-10 sm:py-14">
    <!-- Hero：标题 + 一句话说明 -->
    <header class="relative">
      <div
        class="pointer-events-none absolute -top-20 left-1/2 -z-10 h-64 w-[36rem] -translate-x-1/2 rounded-full bg-accent/15 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        <span class="text-gradient">Apps</span> —— 想到，就做到。
      </h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted">
        vibe coding 把写小应用的门槛从「做到」降到了「想到」。
        这里收录全部 <span class="text-default">{apps.length}</span> 个应用，
        下方标签可按用途筛选；更早的折腾记录在页底时间线里。
      </p>
    </header>

    <!-- Featured：全量应用大卡轮播，自动翻页，悬停暂停 -->
    <section class="mt-12" aria-label="应用轮播" aria-roledescription="carousel">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold tracking-tight">Featured</h2>
        <div class="hidden items-center gap-1.5" id="carousel-controls">
          <button type="button" class="carousel-btn" data-carousel-prev aria-label="上一款应用">&lsaquo;</button>
          <button type="button" class="carousel-btn" data-carousel-next aria-label="下一款应用">&rsaquo;</button>
        </div>
      </div>

      <div
        class="carousel-viewport mt-5 rounded-2xl border border-line bg-surface"
        id="carousel-viewport"
        tabindex="0"
        aria-label="应用卡片，左右滚动或用按钮翻页"
      >
        {
          ordered.map((app) => {
            const gradient = APP_GRADIENTS[app.gradient] ?? APP_GRADIENTS.violet;
            const status = STATUS[app.status];
            const cat = categoryLabel(app);
            return (
              <article class="carousel-card">
                <div class="flex h-full flex-col gap-5 p-7 sm:p-10">
                  <div class="flex items-start gap-5">
                    <div
                      class={`flex size-16 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br ${gradient} text-3xl shadow-inner`}
                      aria-hidden="true"
                    >
                      {app.emoji}
                    </div>
                    <div class="min-w-0">
                      <p class="flex flex-wrap items-center gap-2 text-xs text-faint">
                        <span class={`inline-block size-1.5 rounded-full ${status.dot}`}></span>
                        {status.label}
                        {cat && (
                          <>
                            <span aria-hidden="true">·</span>
                            {cat.label}
                          </>
                        )}
                        <span aria-hidden="true">·</span>
                        {app.addedAt}
                      </p>
                      <h3 class="mt-1.5 text-2xl font-semibold tracking-tight sm:text-3xl">{app.name}</h3>
                    </div>
                  </div>
                  <p class="text-sm leading-relaxed text-muted sm:text-base">{app.tagline}</p>
                  <div class="flex flex-wrap gap-1.5">
                    {app.stack.map((s) => (
                      <span class="rounded-md bg-elevated px-2 py-0.5 font-mono text-[11px] text-muted">
                        {s}
                      </span>
                    ))}
                  </div>
                  {app.links?.live && (
                    <div class="mt-auto flex justify-end border-t border-line/60 pt-4">
                      <a
                        class="text-sm font-medium text-accent transition-colors duration-150 hover:underline"
                        href={app.links.live}
                        target="_blank"
                        rel="noopener"
                      >
                        打开应用 ↗
                      </a>
                    </div>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>

      <div
        class="mt-4 hidden flex-wrap items-center justify-center gap-1.5"
        id="carousel-dots"
        role="group"
        aria-label="轮播页码"
      >
        {
          ordered.map((app, i) => (
            <button
              type="button"
              class="carousel-dot"
              data-carousel-dot
              aria-label={`第 ${i + 1} 款：${app.name}`}
            />
          ))
        }
      </div>
    </section>

    <!-- 全部应用：分类筛选（只作用于下方网格，轮播不受影响） -->
    <section class="mt-14" aria-label="全部应用">
      <div
        id="filter-bar"
        class="hidden flex-wrap items-center gap-2"
        role="group"
        aria-label="按用途分类筛选"
      >
        <button type="button" class="app-pill" data-filter="all" aria-pressed="true">
          全部<span class="app-pill-count">{active.length}</span>
        </button>
        {
          CATEGORIES.map((c) => (
            <button type="button" class="app-pill" data-filter={c.id} aria-pressed="false">
              {c.label}
              <span class="app-pill-count">{countOf(c.id)}</span>
            </button>
          ))
        }
        {
          uncategorized > 0 && (
            <button type="button" class="app-pill" data-filter="uncategorized" aria-pressed="false">
              未分类<span class="app-pill-count">{uncategorized}</span>
            </button>
          )
        }
      </div>

      <div id="app-grid" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          active.map((app, i) => (
            <div data-category={app.category ?? "uncategorized"} style={`--i:${i}`}>
              <AppCard app={app} class="h-full" vibeBadge={false} />
            </div>
          ))
        }
      </div>
      <p
        id="grid-empty"
        hidden
        class="mt-6 rounded-2xl border border-dashed border-line p-8 text-center text-sm text-muted"
      >
        这个分类下暂时没有在线应用，欢迎来
        <a class="text-accent hover:underline" href="https://github.com/itabas016" target="_blank" rel="noopener">GitHub</a>
        提个需求。
      </p>
    </section>

    <!-- 早期作品时间线 -->
    <section class="mt-16" aria-label="早期作品">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-xl font-semibold tracking-tight">早期作品</h2>
        <span class="text-sm text-faint">比 vibe coding 更早的折腾</span>
      </div>
      <ol class="mt-3">
        {
          archived.map((app) => (
            <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-line/60 py-3.5">
              <span class="w-16 shrink-0 font-mono text-xs tabular-nums text-faint">{app.addedAt}</span>
              <span class="text-lg leading-none" aria-hidden="true">{app.emoji}</span>
              {app.links?.live ? (
                <a
                  class="font-medium transition-colors hover:text-accent"
                  href={app.links.live}
                  target="_blank"
                  rel="noopener"
                >
                  {app.name} ↗
                </a>
              ) : (
                <span class="text-muted">{app.name}</span>
              )}
              <span class="flex-1 text-sm text-muted">{app.tagline}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <p class="mt-10 text-sm text-faint">
      应用数据维护在
      <code class="rounded bg-elevated px-1.5 py-0.5 font-mono text-xs">src/data/apps.ts</code>
      · 加一条记录即上新 · 想了解某个应用的实现细节，来
      <a class="text-accent hover:underline" href="https://github.com/itabas016" target="_blank" rel="noopener">GitHub</a>
      找我聊。
    </p>
  </div>
</BaseLayout>

<style>
  /* ---------- 轮播 ---------- */
  .carousel-viewport {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .carousel-viewport::-webkit-scrollbar {
    display: none;
  }
  .carousel-viewport:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .carousel-card {
    flex: 0 0 100%;
    min-width: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .carousel-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    color: var(--text-muted);
    font-size: 1.125rem;
    line-height: 1;
    transition: color 150ms cubic-bezier(0.23, 1, 0.32, 1), border-color 150ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .carousel-btn:hover {
    border-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
    color: var(--color-accent);
  }
  .carousel-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: var(--line);
    transition: width 200ms cubic-bezier(0.23, 1, 0.32, 1), background-color 150ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .carousel-dot:hover {
    background: var(--text-faint);
  }
  .carousel-dot[aria-current="true"] {
    width: 20px;
    background: var(--color-accent);
  }
  .carousel-dot:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ---------- 筛选 pill：aria-pressed 驱动选中态 ---------- */
  .app-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    transition: color 150ms cubic-bezier(0.23, 1, 0.32, 1), border-color 150ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 150ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .app-pill:hover {
    border-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
    color: var(--text-default);
  }
  .app-pill:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .app-pill[aria-pressed="true"] {
    border-color: color-mix(in oklab, var(--color-accent) 45%, transparent);
    background-color: color-mix(in oklab, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
  }
  .app-pill-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .app-pill[aria-pressed="true"] .app-pill-count {
    color: var(--color-accent);
  }

  /* 网格卡片入场 / 筛选重排：淡入上移，stagger 40ms */
  #app-grid > [data-category] {
    animation: card-in 200ms cubic-bezier(0.23, 1, 0.32, 1) both;
    animation-delay: calc(var(--i, 0) * 40ms);
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #app-grid > [data-category] {
      animation: none;
    }
  }
</style>

<script>
  // ---------- 轮播：自动翻页，悬停/聚焦暂停，reduced-motion 停用自动播放 ----------
  const section = document.querySelector<HTMLElement>("section[aria-roledescription='carousel']")!;
  const viewport = document.getElementById("carousel-viewport")!;
  const cards = [...viewport.children] as HTMLElement[];
  const dots = [...document.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]")];
  const controls = document.getElementById("carousel-controls")!;
  const dotsBar = document.getElementById("carousel-dots")!;
  const prevBtn = controls.querySelector<HTMLButtonElement>("[data-carousel-prev]")!;
  const nextBtn = controls.querySelector<HTMLButtonElement>("[data-carousel-next]")!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  let index = 0;
  let timer: ReturnType<typeof setInterval> | null = null;

  function syncDots() {
    dots.forEach((dot, di) => {
      if (di === index) dot.setAttribute("aria-current", "true");
      else dot.removeAttribute("aria-current");
    });
  }

  function goTo(i: number, animate = true) {
    index = (i + cards.length) % cards.length;
    viewport.scrollTo({
      left: index * viewport.clientWidth,
      behavior: animate && !reduce ? "smooth" : "auto",
    });
    syncDots();
  }

  // 手动滑动时同步页码
  viewport.addEventListener(
    "scroll",
    () => {
      const i = Math.min(cards.length - 1, Math.round(viewport.scrollLeft / viewport.clientWidth));
      if (i !== index) {
        index = i;
        syncDots();
      }
    },
    { passive: true },
  );

  function play() {
    if (reduce || timer) return;
    timer = setInterval(() => goTo(index + 1), 5000);
  }
  function stop() {
    if (timer) {
      clearInterval(timer);
      timer = null;
    }
  }

  prevBtn.addEventListener("click", () => {
    goTo(index - 1);
    play();
  });
  nextBtn.addEventListener("click", () => {
    goTo(index + 1);
    play();
  });
  dots.forEach((dot, di) =>
    dot.addEventListener("click", () => {
      goTo(di);
      play();
    }),
  );
  section.addEventListener("pointerenter", stop);
  section.addEventListener("pointerleave", play);
  section.addEventListener("focusin", stop);
  section.addEventListener("focusout", play);
  document.addEventListener("visibilitychange", () => (document.hidden ? stop() : play()));
  addEventListener("resize", () => goTo(index, false));

  syncDots();
  controls.classList.remove("hidden");
  controls.classList.add("flex");
  dotsBar.classList.remove("hidden");
  dotsBar.classList.add("flex");
  play();

  // ---------- 分类筛选：只作用于网格，轮播常驻 ----------
  const bar = document.getElementById("filter-bar")!;
  const pills = [...bar.querySelectorAll<HTMLButtonElement>("button[data-filter]")];
  const gridCards = [...document.querySelectorAll<HTMLElement>("#app-grid > [data-category]")];
  const empty = document.getElementById("grid-empty")!;

  const fromUrl = new URLSearchParams(location.search).get("c");
  const initial = pills.some((p) => p.dataset.filter === fromUrl) ? fromUrl! : "all";

  function apply(filter: string) {
    for (const pill of pills) {
      pill.setAttribute("aria-pressed", String(pill.dataset.filter === filter));
    }
    let visible = 0;
    for (const card of gridCards) {
      const show = filter === "all" || card.dataset.category === filter;
      card.hidden = !show;
      if (show) card.style.setProperty("--i", String(visible++));
    }
    empty.hidden = visible !== 0;
  }

  apply(initial);
  bar.classList.remove("hidden");
  bar.classList.add("flex");

  pills.forEach((pill) =>
    pill.addEventListener("click", () => {
      apply(pill.dataset.filter!);
      const url = new URL(location.href);
      if (pill.dataset.filter === "all") url.searchParams.delete("c");
      else url.searchParams.set("c", pill.dataset.filter!);
      history.replaceState(null, "", url);
      // 重触发入场动画
      for (const card of gridCards) {
        if (card.hidden) continue;
        card.style.animation = "none";
        void card.offsetWidth;
        card.style.animation = "";
      }
    }),
  );
</script>
